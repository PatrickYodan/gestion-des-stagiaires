# Copier ce fichier en ".env" (même dossier que manage.py) puis renseigner les valeurs.
# Le fichier .env contient des secrets : ne jamais le partager ni le versionner.

# --- Gmail (recommandé) -------------------------------------------------------
# Nécessite la validation en 2 étapes sur le compte Google, puis un « mot de passe
# d'application » : https://myaccount.google.com/apppasswords (16 caractères, sans espaces)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=adresse.expediteur@gmail.com
EMAIL_HOST_PASSWORD=mot_de_passe_d_application

# --- Outlook / Hotmail : EMAIL_HOST=smtp-mail.outlook.com  EMAIL_PORT=587  EMAIL_USE_TLS=1
# --- Port 465 (SSL)     : EMAIL_PORT=465  EMAIL_USE_TLS=0  EMAIL_USE_SSL=1

# Expéditeur affiché (facultatif, par défaut : l'adresse EMAIL_HOST_USER)
# DEFAULT_FROM_EMAIL=Mairie - Gestion des Stagiaires <adresse.expediteur@gmail.com>


# Lien de l'application dans les e-mails. Par défaut : adresse du PC sur le réseau local (ex. http://192.168.1.39:5173)
# FRONTEND_URL=http://192.168.1.39:5173
